LOG_LEVEL=INFO

# API authentication — set a strong secret to protect all UI-facing endpoints.
# Leave empty to disable auth (safe for fully local, trusted environments).
API_SECRET_KEY=

# CORS — JSON array of allowed origins
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Provider: openai | openrouter | groq | ollama
LLM_PROVIDER=openrouter

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4-turbo

OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-3.5-turbo

GROQ_API_KEY=gsk_...

OLLAMA_BASE_URL=http://localhost:11434

TELEGRAM_BOT_TOKEN=your-telegram-bot-token

TAVILY_API_KEY=tvly-...

# Fernet key for encrypting tool API keys at rest.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOOL_ENCRYPTION_KEY=

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/agent_db
REDIS_URL=redis://redis:6379
